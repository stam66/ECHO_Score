# ECHOScore secrets - TEMPLATE (safe to commit; contains no real values)
#
# Copy this file to the location the Secrets module reads from, then fill in
# the real values. NEVER commit the populated secrets.env.
#   Regular server / local debug : /etc/ECHOSCORE/secrets.env
#   Xojo Cloud                    : SharedDocuments/ECHOSCORE/secrets.env
#
# The same file format works in both places. DB_USERNAME / DB_PASSWORD are used
# on a regular server (including local debug builds on your Mac);
# XOJO_DB_USERNAME / XOJO_DB_PASSWORD are used on Xojo Cloud. Secrets.Load()
# selects the right pair for the build target.
#
# Format: KEY=value, one per line. Lines starting with '#' are comments.
# Surrounding quotes on a value are optional and stripped on load.

# Database (regular server / local debug build)
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Database (Xojo Cloud)
XOJO_DB_USERNAME=your_xojo_cloud_db_user
XOJO_DB_PASSWORD=your_xojo_cloud_db_password

# MailJet API credentials (Account settings > REST API > API Key Management)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
